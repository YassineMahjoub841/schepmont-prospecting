# Copy to .env and fill in. .env is gitignored.

# --- GCP project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west9

# --- Terraform-managed resources (match terraform/terraform.tfvars) ---
GCS_BUCKET=schepmont-h1b-raw
BQ_DATASET=h1b_ohio_mfg

# --- DOL LCA source ---
# Substitution tokens: {fiscal_year} and {quarter}. Confirm the exact path
# pattern on https://www.dol.gov/agencies/eta/foreign-labor/performance
# before first run; DOL has shuffled the URL structure between releases.
LCA_SOURCE_URL_TEMPLATE=https://www.dol.gov/sites/dolgov/files/ETA/oflc/pdfs/LCA_Disclosure_Data_FY{fiscal_year}_{quarter}.xlsx

# --- Credentials ---
# Absolute path on the host machine to the kestra-ingestion service account
# key JSON. Generate after `terraform apply` using the SA email shown in
# `terraform output kestra_service_account_email`.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/absolute/path/to/kestra-ingestion-key.json
